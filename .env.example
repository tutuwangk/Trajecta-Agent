# 后端启动时读取项目根目录的 .env。
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
AMAP_API_KEY=your_amap_web_service_key

# V3 生产规划与结构化提炼使用 DeepSeek V4 Flash，启用 thinking。
# 模型、调用预算和超时由 V3 provider 与 Runtime 代码管理。

# Optional: AGENT_V3_DATABASE_PATH=data/trip_agent_v3.sqlite3
# Optional: CORS_ORIGINS=http://localhost:3000
# Optional: AMAP_BASE_URL=https://restapi.amap.com/v3
# 高德临时错误的额外重试次数；2 表示最多请求 3 次。
# Optional: AMAP_MAX_RETRIES=2
# 营业、预约等运营事实使用公开网页搜索。
# Optional: POI_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
# Optional: POI_WEB_SEARCH_TIMEOUT_SECONDS=12

# 前端配置通过进程环境或 frontend/.env.local 提供。
# 本机访问默认连接 http://127.0.0.1:8000；跨机器部署设置后端地址。
# Optional: BACKEND_API_BASE_URL=https://your-backend-host
# 兼容已有前端部署的 NEXT_PUBLIC_API_BASE_URL。
